# ============================================================================
# FAMILY Wealth Intelligence — Production Environment Configuration (.env)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8.4 LTS)
# ----------------------------------------------------------------------------
DB_ROOT_PASSWORD=ChangeMe_RootPassword2026!
DB_NAME=family_db
DB_USER=family
DB_PASSWORD=ChangeMe_AppPassword2026!

# Connection URL for app (automatically matched by docker-compose)
DATABASE_URL=mysql://family:ChangeMe_AppPassword2026!@mysql:3306/family_db
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# 2. Security & Encryption Keys (CRITICAL: Must be >= 32 characters)
# ----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long!
AUDITOR_PORTAL_JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long!
VAULT_ENCRYPTION_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long!

# ----------------------------------------------------------------------------
# 3. Application Runtime
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
STORAGE_LOCAL_DIR=/app/vault_storage

# ----------------------------------------------------------------------------
# 4. Optional: Cloudflare Zero-Trust Ingress Tunnel
# ----------------------------------------------------------------------------
# If deploying behind Cloudflare Tunnel (profiles: [tunnel]), supply token here:
CLOUDFLARE_TUNNEL_TOKEN=

# ----------------------------------------------------------------------------
# 5. Optional: Google OAuth 2.0 Credentials (Single Sign-On)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/callback/google

# ----------------------------------------------------------------------------
# 6. Optional: Gmail SMTP for Financial Alerts & Email Notifications
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
